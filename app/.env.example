# The app boots with these exact demo values built in as defaults (see
# src/lib/env.ts), so you do NOT need to copy this file to get started with
# the emulators. Copy this file to .env.local (already gitignored) only when
# you have a real Firebase project to point at and want to override them.
#
# IMPORTANT: everything in this file is a VITE_* variable, which means it is
# bundled into the client and publicly visible. That is fine for Firebase's
# client config below — those values are identifiers, not secrets; access
# control is enforced by Firestore Security Rules and Cloud Functions, not by
# hiding this config. Real secrets (PayHere merchant secret, etc.) must NEVER
# go in a VITE_* variable or in this file — see functions/README.md.

# --- Firebase client config (from Firebase Console > Project settings) ---
# For emulator-only local dev, these can stay as placeholders: the Auth/
# Firestore/Functions emulators do not validate them. Use a "demo-" prefixed
# project id (e.g. demo-apex-cinema) to guarantee no real GCP project is ever
# contacted, even by accident.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-apex-cinema.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-apex-cinema
VITE_FIREBASE_STORAGE_BUCKET=demo-apex-cinema.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- Local emulator toggle ---
# When true, the app connects to the local Firebase Emulator Suite instead of
# any real Firebase project, regardless of the values above. Defaults to true
# in dev builds (see src/lib/env.ts) — set explicitly to be unambiguous.
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
