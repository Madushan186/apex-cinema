{
  "name": "functions",
  "private": true,
  "version": "0.0.0",
  "description": "Apex Cinema Cloud Functions — the only writer of bookings/payments/roles/audit log. See docs/ARCHITECTURE.md.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed:emulator": "node lib/scripts/seed.js",
    "seed:auth": "node lib/scripts/seedAuthUsers.js"
  },
  "dependencies": {
    "@apex-cinema/booking-core": "*",
    "firebase-admin": "14.4.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0"
  }
}
